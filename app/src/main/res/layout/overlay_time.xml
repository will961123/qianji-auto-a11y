<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:elevation="16dp"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/timeBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="-8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选择账单时间"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
    <DatePicker
        android:id="@+id/timeDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:calendarViewShown="true"
        android:datePickerMode="calendar"
        android:theme="@style/Theme.AutoQianji.Overlay" />



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <NumberPicker
            android:id="@+id/timeHour"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1" />

        <NumberPicker
            android:id="@+id/timeMinute"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1" />

        <NumberPicker
            android:id="@+id/timeSecond"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/timeConfirm"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_primary"
        android:gravity="center"
        android:text="确定"
        android:textColor="@color/on_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
