<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外两层淡色轮廓，模拟投影 -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A000000" />
            <corners
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp" />
        </shape>
    </item>
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#14000000" />
            <corners
                android:topLeftRadius="23dp"
                android:topRightRadius="23dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
        </shape>
    </item>
</layer-list>